rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // "site/properties" and "site/settings" (map location) —
    // anyone can read (so the public website loads listings),
    // only your admin Google account can write (add/edit/delete).
    match /site/{doc} {
      allow read: if true;
      allow write: if request.auth != null
                    && request.auth.token.email == 'abdulhadi7888888@gmail.com';
    }

    // Everything else stays locked down by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
