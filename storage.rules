rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // "properties/*" — property photos.
    // Anyone can view (so photos load on the public site),
    // only your admin Google account can upload.
    match /properties/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                    && request.auth.token.email == 'abdulhadi7888888@gmail.com';
    }

    // Everything else stays locked down by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
